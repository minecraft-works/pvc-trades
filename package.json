{
  "name": "shops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:players": "vite --mode players",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run src/library.property.test.ts",
    "test:e2e": "npx bddgen && playwright test --project=chromium --project=chromium-spec --grep-invert \"@visual|@wip\"",
    "test:e2e:headed": "npx bddgen && playwright test --project=chromium --headed",
    "test:e2e:ui": "npx bddgen && playwright test --project=chromium --ui",
    "test:bdd": "npx bddgen && playwright test --project=chromium",
    "test:bdd:headed": "npx bddgen && playwright test --project=chromium --headed",
    "test:bdd:ui": "npx bddgen && playwright test --project=chromium --ui",
    "test:spec": "playwright test --project=chromium-spec",
    "test:all": "npm run test && npm run test:e2e",
    "test:mutation": "stryker run",
    "test:load": "playwright test --project=perf",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"features/**/*.ts\" \"workers/**/*.ts\"",
    "lint:css": "stylelint styles.css",
    "lint:html": "htmlhint index.html",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"features/**/*.ts\" \"workers/**/*.ts\" --fix && stylelint styles.css --fix",
    "check": "npm run typecheck && npm run lint:all && npm run knip && npm run lint:filenames && npm run lint:lockfile && npm run lint:deps && npm run lint:parse-safety && npm run test:coverage",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:filenames": "ls-lint",
    "lint:lockfile": "lockfile-lint --type npm --path package-lock.json --allowed-hosts npm --validate-https",
    "lint:parse-safety": "tsx scripts/check-parse-safety.ts",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "prepare": "husky",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "120 kB"
    }
  ],
  "lint-staged": {
    "{src,scripts,workers,tests,features}/**/*.ts": "eslint --fix",
    "styles.css": "stylelint",
    "index.html": "htmlhint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/debug": "^4.1.13",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-jsdoc": "^65.5.6",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.3",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.11.0",
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "lockfile-lint": "^5.1.1",
    "playwright-bdd": "^9.2.1",
    "size-limit": "^14.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "leaflet": "^1.9.4",
    "virtual-scroller": "^1.16.4",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": ">=10.2.3",
    "deepmerge-ts": "^8.0.2"
  }
}
