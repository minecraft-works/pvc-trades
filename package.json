{
  "name": "shops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:css": "stylelint styles.css",
    "lint:html": "htmlhint index.html",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html",
    "lint:fix": "eslint src/**/*.ts --fix && stylelint styles.css --fix",
    "fetch-data": "node scripts/fetch-data.js"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint",
    "styles.css": "stylelint",
    "index.html": "htmlhint"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.0.0",
    "htmlhint": "^1.1.4",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "zod": "^4.3.5"
  }
}
