{
  "name": "shops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:cucumber": "npx tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:cucumber:headed": "cross-env HEADED=true npx tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:all": "npm run test && npm run test:e2e && npm run test:cucumber",
    "lint": "eslint src/**/*.ts",
    "lint:css": "stylelint styles.css",
    "lint:html": "htmlhint index.html",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html",
    "lint:fix": "eslint src/**/*.ts --fix && stylelint styles.css --fix",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "fetch-tiles": "tsx scripts/fetch-tiles.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": "eslint",
    "scripts/**/*.ts": "eslint",
    "tests/**/*.spec.ts": [
      "eslint",
      "npm run test:e2e"
    ],
    "tests/helpers/**/*.ts": "eslint",
    "features/**/*.ts": "eslint",
    "styles.css": "stylelint",
    "index.html": "htmlhint"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@playwright/test": "^1.58.0",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.0.0",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "sharp": "^0.34.5",
    "tslib": "^2.8.1",
    "virtual-scroller": "^1.15.3",
    "zod": "^4.3.5"
  }
}
