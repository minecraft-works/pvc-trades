{
  "name": "shops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run src/library.property.test.ts",
    "test:e2e": "npx bddgen && playwright test --project=chromium && playwright test --project=chromium-spec",
    "test:e2e:headed": "npx bddgen && playwright test --project=chromium --headed",
    "test:e2e:ui": "npx bddgen && playwright test --project=chromium --ui",
    "test:bdd": "npx bddgen && playwright test --project=chromium",
    "test:bdd:headed": "npx bddgen && playwright test --project=chromium --headed",
    "test:bdd:ui": "npx bddgen && playwright test --project=chromium --ui",
    "test:spec": "playwright test --project=chromium-spec",
    "test:all": "npm run test && npm run test:e2e",
    "test:mutation": "stryker run",
    "test:load": "playwright test --project=chromium-spec tests/tile-load-testing.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:css": "stylelint styles.css",
    "lint:html": "htmlhint index.html",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:html",
    "lint:fix": "eslint src/**/*.ts --fix && stylelint styles.css --fix",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "docs": "typedoc",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:circular": "madge --circular --extensions ts src/",
    "lint:filenames": "ls-lint",
    "lint:lockfile": "lockfile-lint --type npm --path package-lock.json --allowed-hosts npm --validate-https",
    "lint:parse-safety": "tsx scripts/check-parse-safety.ts",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "fetch-tiles": "tsx scripts/fetch-tiles.ts",
    "render-tiles": "tsx scripts/render-tiles.ts",
    "validate-tiles": "tsx scripts/validate-tiles.ts",
    "prepare": "husky",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "120 kB"
    }
  ],
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "scripts/**/*.ts": "eslint --fix",
    "tests/**/*.spec.ts": [
      "eslint --fix"
    ],
    "tests/helpers/**/*.ts": "eslint --fix",
    "features/**/*.ts": [
      "eslint --fix"
    ],
    "styles.css": "stylelint",
    "index.html": "htmlhint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.39.2",
    "@ls-lint/ls-lint": "^2.3.1",
    "@playwright/test": "^1.58.0",
    "@size-limit/file": "^12.0.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@types/debug": "^4.1.12",
    "@types/leaflet": "^1.9.21",
    "@vitest/coverage-v8": "^4.0.16",
    "dependency-cruiser": "^17.3.8",
    "eslint": "^9.0.0",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.5.3",
    "htmlhint": "^1.9.1",
    "husky": "^9.1.7",
    "knip": "^5.85.0",
    "lint-staged": "^16.2.7",
    "lockfile-lint": "^5.0.0",
    "madge": "^8.0.0",
    "playwright": "^1.57.0",
    "playwright-bdd": "^8.4.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.34.5",
    "size-limit": "^12.0.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "leaflet": "^1.9.4",
    "virtual-scroller": "^1.15.3",
    "zod": "^4.3.5"
  }
}
