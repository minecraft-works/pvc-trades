{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/*.ts", "src/chatlog/run-parser.ts", "workers/*/index.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "workers/**/*.ts"],
